# Hidden blog editor at /studio — temporary until the database-backed editor lands.
# Copy this file to .env.local and fill in real values (.env.local is gitignored).

# Password for the /studio login screen (shared secret, single user).
BLOG_STUDIO_PASSWORD=

# Random string used to sign the studio session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLOG_STUDIO_SECRET=

# Optional. By default the /studio editor only writes .md files outside production
# (i.e. local `next dev` / `next start`). Set to "true" to allow writes in a
# production build running on a host with a persistent filesystem.
# STUDIO_ALLOW_WRITES=false
