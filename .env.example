# Copy to .env.local for local development (never commit secrets).
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prefer publishable key. ANON_KEY is accepted as an alias by the app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Never put sb_secret_ / service_role in NEXT_PUBLIC_* or client code.

# Server-only. Used by scripts/migrate-blog.mjs — never NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=
